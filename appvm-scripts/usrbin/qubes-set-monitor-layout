#!/bin/bash

# This may be called before qubes-session is fully initialized, so do not rely
# on having DISPLAY set from there
export DISPLAY=:0

if [ -e /run/qubes-service/guivm-gui-agent ]; then
    # on sys-gui, adjust monitor layout of the parent Xorg
    export DISPLAY=:1
fi

# Wait for Xorg complete startup
while ! xrandr -q &>/dev/null; do sleep 0.1; done

output_no=0
output_base=DUMMY
output_max=$[ `xrandr | grep -c ^$output_base` - 1 ]

xrandr_cmd=""

while read w h x y w_mm h_mm extra; do
    output_name=$output_base$output_no
    mode_name="QB${w}x${h}"
    if ! xrandr | grep -q $mode_name; then
        cvt=`cvt $w $h | tail -n 1 | cut -d ' ' -f 3-`
        xrandr --newmode $mode_name $cvt
    fi
    xrandr --addmode $output_name $mode_name
    # Do not set it at once b/c xserver resets position after output gets
    # "connected" - the case for first mode set
    xrandr_cmd="$xrandr_cmd --output $output_name --mode $mode_name --pos ${x}x${y}"
    # Set physical dimensions if provided (for HiDPI being handled automatically)
    if [ -n "$w_mm" -a -n "$h_mm" ]; then
        xrandr_cmd="$xrandr_cmd --set WIDTH_MM $w_mm --set HEIGHT_MM $h_mm"
    fi
    output_no=$[ $output_no + 1]
done

for i in `seq $output_no $output_max`; do
    xrandr_cmd="$xrandr_cmd --output $output_base$i --off"
done

xrandr $xrandr_cmd
xrandr --query >/dev/null

# DPI - Configure DPI according to Window Scaling Factor
scaling="$(qubesdb-read /dpi/scale)"
if [ "$?" -ne 0 ]; then
    echo "Unable to read /dpi/scale value from DB: ${scaling}" >&2
else
    dpi="$(( 96 * scaling ))"
    dpi_real_value="$(( dpi * 1024 ))"
    unscaled_dpi="98304" # 96 * 1024

    # Configure Xsettings DPI values with xfconf
    if command -v xfconf-query &>/dev/null; then
        # Global DPI => Set 96 * SCALING
        xfconf-query -c xsettings -n -p /Xft/DPI -s $dpi -t int

        # --- GTK ---
        # /Xft/DPI renders very badly for GTK apps
        # Prefer using /Gdk/WindowScalingFactor
        # Requires /Gdk/UnscaledDPI to prevent scaling fonts twice
        # (WindowScalingFactor + /Xft/DPI)
        xfconf-query -c xsettings -n -p /Gdk/WindowScalingFactor -s $scaling -t int
        xfconf-query -c xsettings -n -p /Gdk/UnscaledDPI -s "$unscaled_dpi" -t int # 96 * 1024
    fi

    if command -v xsettingsd &>/dev/null; then
      if [ "$UID" -ne 0 ]; then
        target_file="${HOME}/.xsettingsd"
        if [ ! -f "$target_file" ]; then
          if [ -f "/etc/xdg/xsettingsd" ]; then
            cp /etc/xdg/xsettingsd "$target_file"
          else
            touch "$target_file"
          fi
        fi

        if grep -q "Xft/DPI[[:space:]]" "$target_file"; then
          sed -i -E "s#Xft/DPI(\s+)?(.*)#Xft/DPI ${dpi_real_value}#" "$target_file"
        else
          echo "Xft/DPI ${dpi_real_value}" >> "$target_file"
        fi

        if grep -q "Gdk/WindowScalingFactor[[:space:]]" "$target_file"; then
          sed -i -E "s#Gdk/WindowScalingFactor(\s+)?(.*)#Gdk/WindowScalingFactor ${scaling}#" "$target_file"
        else
          echo "Gdk/WindowScalingFactor ${scaling}" >> "$target_file"
        fi

        if grep -q "Gdk/UnscaledDPI[[:space:]]" "$target_file"; then
          sed -i -E "s#Gdk/UnscaledDPI(\s+)?(.*)#Gdk/UnscaledDPI ${unscaled_dpi}#" "$target_file"
        else
          echo "Gdk/UnscaledDPI ${unscaled_dpi}" >> "$target_file"
        fi
      fi

      pkill -HUP -u "$(id -u)" -x xsettingsd || true
    fi
fi


